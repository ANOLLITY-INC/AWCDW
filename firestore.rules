rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 헬퍼 ----------
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return hasProfile() ? userDoc().role : '';
    }
    function isAdmin()    { return myRole() == 'admin'; }
    function isProfessor(){ return myRole() == 'professor'; }
    function isDesigner() { return myRole() == 'designer'; }
    function isEngineer() { return myRole() == 'engineer'; }

    // ---------- 사용자 프로필 ----------
    match /users/{userId} {
      // 본인 또는 관리자만 열람
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // 자가 가입: 본인 문서만, 역할은 designer/engineer 로 제한(권한 상승 방지)
      allow create: if request.auth.uid == userId
                    && request.resource.data.role in ['designer', 'engineer'];
      // 수정: 관리자는 전체 / 본인은 역할(role) 변경 불가
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);
      // 삭제: 관리자 또는 본인(회원 탈퇴)
      allow delete: if isAdmin() || request.auth.uid == userId;
    }

    // ---------- 디자인팀 ----------
    // 공개 팀 보드 유지를 위해 읽기는 공개, 쓰기는 관리자만
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 작품 (Phase 2에서 화면 구현) ----------
    match /works/{workId} {
      // public 은 모두, team_only/professor_only 는 로그인 + 권한자
      allow read: if resource.data.visibility == 'public'
                  || (signedIn() && (
                        isAdmin() || isProfessor()
                        || (isDesigner() && userDoc().teamId == resource.data.teamId)
                     ));
      allow create: if isDesigner()
                    && userDoc().teamId == request.resource.data.teamId;
      allow update, delete: if isAdmin()
                    || (isDesigner() && userDoc().teamId == resource.data.teamId);
    }

    // ---------- 피드백 (Phase 3) ----------
    //  · 작성: 모든 교수 + 관리자 (담당팀 제한 없음). authorId 는 본인이어야 함.
    //  · 공개(public): 누구나 read. 팀원만(team_only): 해당 작품 팀 디자이너 + 교수 + 관리자.
    //    (works 와 동일한 쿼리 친화적 구조 — 단일필드 쿼리가 규칙 분석을 통과하도록)
    match /feedbacks/{feedbackId} {
      allow read: if resource.data.visibility == 'public'
                  || (signedIn() && (
                        isAdmin() || isProfessor()
                        || (isDesigner() && userDoc().teamId == resource.data.teamId)
                     ));
      allow create: if (isProfessor() || isAdmin())
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin()
                    || (signedIn() && request.auth.uid == resource.data.authorId);
    }

    // ---------- 앱 설정 (관리자 전역 토글) ----------
    //  settings/app.rosterPublic: 지원자 명단을 학생 전체에 공개할지 여부.
    //  읽기 공개(대시보드 메뉴 노출 판단), 쓰기 관리자만.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 지원서 (Phase 4) — 선착순 즉시 배정 ----------
    //  · 문서 ID = engineerId(uid) → 1인 1지원 보장.
    //  · read: 로그인 사용자 전체(지원 보드의 팀별 정원/마감·배정 현황 표시를 위해 공개).
    //    (지원 정보는 본질적으로 팀 배정 명단 성격이라 로그인 사용자에 공개)
    //  · create/update/delete: 본인(engineer) 또는 관리자.
    match /applications/{appId} {
      allow read: if signedIn();
      allow create: if isEngineer()
                    && appId == request.auth.uid
                    && request.resource.data.engineerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isEngineer()
                        && request.auth.uid == resource.data.engineerId
                        && request.resource.data.engineerId == request.auth.uid);
      allow delete: if isAdmin()
                    || (isEngineer() && request.auth.uid == resource.data.engineerId);
    }
  }
}
